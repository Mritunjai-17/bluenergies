e:[["$","header",null,{"className":"page-hero","style":{"minHeight":"260px","paddingTop":"130px","paddingBottom":"50px"},"children":[["$","div",null,{"className":"container","style":{"maxWidth":"900px"},"children":[["$","div",null,{"className":"eyebrow eyebrow-dark","children":[["$","svg",null,{"className":"eyebrow-wave","viewBox":"0 0 34 8","fill":"none","xmlns":"http://www.w3.org/2000/svg","aria-hidden":"true","children":["$","path",null,{"d":"M1 4C5 1 9 1 13 4C17 7 21 7 25 4C28 1.8 31 2 33 4","stroke":"#51C2C9","strokeWidth":"1.8","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","span",null,{"children":"News release"}]]}],["$","div",null,{"style":{"color":"var(--teal)","fontWeight":500,"fontSize":"1rem","marginBottom":"12px","letterSpacing":"0.02em"},"children":"July 23, 2026"}],["$","h1",null,{"style":{"fontSize":"clamp(2rem, 4vw, 3.2rem)","marginBottom":0},"children":"BluEnergies announces closing of non-brokered private placement of units for gross proceeds of C$20.7 million"}]]}],["$","svg",null,{"className":"page-hero-wave","viewBox":"0 0 1440 28","fill":"none","preserveAspectRatio":"none","xmlns":"http://www.w3.org/2000/svg","aria-hidden":"true","children":["$","path",null,{"d":"M0 14C240 2 480 26 720 14C960 2 1200 26 1440 14V28H0V14Z","fill":"#51C2C9","fillOpacity":"0.12"}]}]]}],["$","section",null,{"id":"$undefined","className":"section section-paper theme-light","style":"$undefined","children":["$","div",null,{"className":"container","children":["$","div",null,{"style":{"maxWidth":"820px","margin":"0 auto"},"children":[["$","div",null,{"style":{"marginBottom":"32px"},"children":["$","$L6",null,{"href":"/news-and-media/news/","className":"btn btn-quiet","id":"$undefined","children":"← Back to all news"}]}],["$","article",null,{"className":"news-body-content","style":{"fontSize":"1.05rem","lineHeight":1.75,"color":"var(--ink)"},"children":[["$","p","0",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"VANCOUVER, BC — BluEnergies Ltd. (TSXV: BLU) (\"BluEnergies\" or the \"Company\") is pleased to announce that further to its news release of July 21, 2026, it has closed its upsized non-brokered private placement of 9,202,027 units (the \"Units\") at an issue price of C$2.25 per Unit for aggregate gross proceeds of C$20,704,560.75."}],["$","p","1",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"Each Unit consists of one common share of the Company and one-half of one transferable common share purchase warrant. Each whole warrant entitles the holder to purchase one common share at an exercise price of C$3.00 for a period of 24 months from the closing date."}],["$","p","2",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"Gross proceeds from the offering will be used to fund the technical work programme across Blocks LB-26, LB-30, and LB-31 in the Harper Basin offshore Liberia, working capital, and general corporate purposes."}],["$","p","3",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"All securities issued under the offering are subject to a statutory four-month hold period under applicable Canadian securities legislation."}]]}],["$","div",null,{"style":{"marginTop":"48px","paddingTop":"32px","borderTop":"1px solid var(--line)","display":"flex","justifyContent":"space-between","alignItems":"center","flexWrap":"wrap","gap":"16px"},"children":[["$","div",null,{"children":[["$","strong",null,{"children":"BluEnergies Ltd."}]," (TSXV: BLU | OTCQX: BLUGF)",["$","br",null,{}],["$","span",null,{"style":{"fontSize":"0.9rem","color":"var(--muted)"},"children":["Investor Relations: ",["$","a",null,{"href":"mailto:info@blu-energies.com","style":{"color":"var(--deep-teal)"},"children":"info@blu-energies.com"}]]}]]}],["$","$L6",null,{"href":"/news-and-media/news/","className":"btn btn-secondary btn-secondary-light","id":"$undefined","children":"Back to all news"}]]}]]}]}]}]]
