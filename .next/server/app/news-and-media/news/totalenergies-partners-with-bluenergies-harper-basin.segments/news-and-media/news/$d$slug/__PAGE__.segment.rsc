13:["$","p","1",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"Under the terms of the agreement, TotalEnergies holds a 65% operating interest and BluEnergies holds a 35% participating interest in the licence, which encompasses 8,924 km² (approx. 2.2 million acres) across blocks LB-26, LB-30, and LB-31."}]
14:["$","p","2",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"The licence term extends through June 30, 2027. All agreed expenditures under the reconnaissance licence are eligible for recovery upon transition to production sharing contracts."}]
15:["$","p","3",{"style":{"marginBottom":"1.5rem","maxWidth":"none"},"children":"The Harper Basin represents one of the few remaining lightly explored deepwater Cretaceous fan plays along the West African transform margin, sharing geological affinities with major oil discoveries across Ghana, Côte d’Ivoire, and Namibia."}]
